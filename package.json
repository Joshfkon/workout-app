{
  "name": "workout-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-tesseract-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:types": "tsd",
    "lint:fix": "next lint --fix",
    "lint:services": "npx eslint services/ --rule '{\"no-restricted-imports\": [\"error\", {\"patterns\": [{\"group\": [\"**/supabase/**\"], \"message\": \"Services must be pure. Move DB calls to lib/actions.\"}]}]}'",
    "type-check": "tsc --noEmit",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "cap:livereload:ios": "npx cap run ios --livereload --external",
    "cap:livereload:android": "npx cap run android --livereload --external",
    "generate:exercise-tags": "node scripts/generate-seed-exercise-tags.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-health": "^8.9.3",
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@zxing/library": "^0.21.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "html5-qrcode": "^2.3.8",
    "idb-keyval": "^6.3.0",
    "next": "14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.0",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.2"
  },
  "tsd": {
    "directory": "types/__typetests__"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.6",
    "tsd": "^0.33.0",
    "typescript": "^5"
  }
}
